# EVEZ Credit API

API key for authentication (used in Authorization: Bearer <key>)
EVEZ_API_KEY=

# Server
PORT=8080
HOST=0.0.0.0

# Database (SQLite — file path, defaults to credit_api.db in project root)
DB_PATH=

# Stripe (optional — for paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting (overrides defaults: free=60/min, pro=300/min)
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=300
